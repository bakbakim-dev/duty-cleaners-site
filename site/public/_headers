# Response headers for Netlify / Cloudflare Pages.
#
# Two deliberate choices worth knowing before editing:
#
# 1. Content-Security-Policy ships in Report-Only mode. The site legitimately
#    embeds four third-party origins (Google Maps on 94 location pages, the
#    HighLevel quote form, BookingKoala, OpenStreetMap tiles) plus one inline
#    script -- AND calls the Supabase edge function that every lead goes
#    through. That last one was missing from connect-src while the policy still
#    allowed api.bookin60.com, the HighLevel form endpoint that is dead for
#    external posts (it enforces Turnstile). Enforcing the policy in that state
#    would have blocked the quote submission on every page and lost every lead,
#    silently, since Report-Only reports but does not block. The origin is
#    already public -- it is baked into the client bundle.
#    script. Enforcing a policy that misses one of those takes the page down,
#    and a CSP is not something to guess at. Collect reports first, confirm the
#    allowlist is complete against real traffic, then rename the header to
#    Content-Security-Policy to enforce it.
#
# 2. HSTS is NOT set here. Enabling it is a one-way door -- browsers remember
#    max-age and the domain cannot serve plain HTTP again until it expires.
#    That is the right end state, but it is the owner's call to make knowingly,
#    not a side effect of adding security headers. Add when ready:
#      Strict-Transport-Security: max-age=31536000; includeSubDomains

/*
  # Clickjacking. frame-ancestors is the modern control; X-Frame-Options is
  # kept for older browsers that ignore it.
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

  # Stop MIME sniffing turning an uploaded file into executable script.
  X-Content-Type-Options: nosniff

  # Send the full URL only to ourselves; other origins get the bare origin, so
  # query strings never leak cross-site.
  Referrer-Policy: strict-origin-when-cross-origin

  # This site needs none of these. Denying them means an embedded third party
  # cannot silently ask for them either.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), interest-cohort=()

  # Report-only. See note 1 above before enforcing.
  # The sha256 covers the scroll-reveal bootstrap script inlined in index.html;
  # it changes if that script's text changes by even one character.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-7DMw94E/HaivhL+vPa07tUSnUcoTg16X33czt0+MYCo=' https://api.bookin60.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://maps.googleapis.com https://maps.gstatic.com https://*.google.com; font-src 'self' data:; connect-src 'self' https://api.bookin60.com https://exodbynxmeezenqytkvh.supabase.co; frame-src 'self' https://www.google.com https://api.bookin60.com https://dutycleaners.bookingkoala.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://dutycleaners.bookingkoala.com; object-src 'none'

# Vite writes a content hash into every asset filename, so these are safe to
# cache forever -- a changed file gets a different name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is prerendered and rewritten on every deploy, and its filename never
# changes, so it must revalidate rather than be held in a browser cache.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Crawler-facing files change without a filename change; keep them short-lived.
/sitemap*.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms*.txt
  Cache-Control: public, max-age=3600
