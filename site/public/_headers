# Response headers for Netlify / Cloudflare Pages.
#
# Two deliberate choices worth knowing before editing:
#
# 1. Content-Security-Policy is ENFORCED since 2026-09-27. It shipped Report-Only
#    first, and nearly went live missing the relay every lead went through.
#    Before enforcing, the live pages were read for every origin they load
#    (self, googletagmanager, google-analytics, the BookingKoala gift-card
#    frame) and the full quote funnel was walked locally under this exact
#    policy with a report endpoint: zero violations, and an injected script
#    was blocked. Origins nothing uses any more were dropped at the same time
#    (api.bookin60.com, Google Maps JS, Supabase, the staging host, Google
#    Fonts). Adding a third-party embed, script or fetch now means adding its
#    origin here first, or it is blocked; headers.test.ts derives the bundle's
#    connections and fails when one is missing.
#
# 2. HSTS is set (owner decision, 2026-09-17), raised from one day to two years
#    (63072000) on 2026-09-27 after a clean week (owner), still without
#    includeSubDomains (mail., ftp. and autodiscover. exist and are not
#    confirmed HTTPS) and without preload.

/*
  # Clickjacking. frame-ancestors is the modern control; X-Frame-Options is
  # kept for older browsers that ignore it.
  X-Frame-Options: SAMEORIGIN

  # Origin isolation. same-origin-allow-popups keeps our window isolated from
  # cross-origin openers while the windows we open ourselves (BookingKoala
  # fallback, Google listings — both noopener) keep working.
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # HSTS, see note 2. Netlify hosts only the private preview on *.netlify.app,
  # itself HSTS-preloaded, so this is parity with the Apache rules, where the
  # header is scoped to the production host.
  Strict-Transport-Security: max-age=63072000

  # Stop MIME sniffing turning an uploaded file into executable script.
  X-Content-Type-Options: nosniff

  # Send the full URL only to ourselves; other origins get the bare origin, so
  # query strings never leak cross-site.
  Referrer-Policy: strict-origin-when-cross-origin

  # This site needs none of these. Denying them means an embedded third party
  # cannot silently ask for them either.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), interest-cohort=()

  # Enforced. See note 1 above before editing.
  # The sha256 covers the scroll-reveal bootstrap script inlined in index.html;
  # it changes if that script's text changes by even one character.
  # Google Analytics 4 (src/lib/analytics.ts, only when VITE_GA4_MEASUREMENT_ID is
  # set): gtag.js from www.googletagmanager.com, hits to *.google-analytics.com and
  # *.analytics.google.com, the origins Google's own CSP guide lists for GA4.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-7DMw94E/HaivhL+vPa07tUSnUcoTg16X33czt0+MYCo=' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://*.google.com https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://dutycleaners.bookingkoala.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://dutycleaners.bookingkoala.com; object-src 'none'

# Vite writes a content hash into every asset filename, so these are safe to
# cache forever -- a changed file gets a different name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is prerendered and rewritten on every deploy, and its filename never
# changes, so it must revalidate rather than be held in a browser cache.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Crawler-facing files change without a filename change; keep them short-lived.
/sitemap*.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms*.txt
  Cache-Control: public, max-age=3600
