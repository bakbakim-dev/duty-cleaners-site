# Build-time settings read by Vite (import.meta.env). They are baked into the bundle when
# dist/ is built, and dist/ is built on this machine: scripts/deploy.mjs runs `bun run build`
# locally and uploads with `netlify deploy --no-build`, so Netlify's own environment variables
# are never read. Put values in a file here in site/, then build and deploy as usual.

# Supabase: the ghl-quote relay every quote and contact lead goes through.
# The publishable (anon) key is public by design; it is baked into the bundle.
# These live in site/.env (committed).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional when the frontend and PHP endpoint are on different origins (for
# example, a Netlify preview reporting to SiteGround). Production on SiteGround
# uses /api/form-health.php automatically when this is blank. Never put the
# server shared secret here: every VITE_ value is public.
VITE_FORM_HEALTH_ENDPOINT=

# Google Analytics 4 (optional). The property's web data stream Measurement ID, for example
# G-XXXXXXXXXX. Leave it empty and no analytics script loads at all.
#
# Where it goes: site/.env.production.local (create it; git ignores *.local). Vite reads that
# file for production builds only, so `bun run build`, `bun run deploy:preview` and
# `bun run deploy:production` pick it up and `bun run dev` never does. The ID is not a secret
# (it ships in the page), so site/.env works too if you would rather commit it.
#
# What it does: src/lib/analytics.ts loads gtag.js from https://www.googletagmanager.com only
# on dutycleaners.ca and www.dutycleaners.ca, so the Netlify preview, localhost and the
# prerender (127.0.0.1, headless Chrome) record nothing. It stays off for browsers sending
# Global Privacy Control or Do Not Track. Google signals and ad personalisation are off. The
# site sends its own page views with the query string removed (ad click ids and UTM tags
# kept) and only non-personal funnel events (city, service, step, frequency, price type,
# device class). public/_headers already allows the Google Analytics origins.
#
# In Google Analytics, before the first production build with the ID
# (Admin > Data collection and modification > Data streams > the web stream):
#   1. Enhanced measurement > gear icon: switch OFF "Outbound clicks" and "Form interactions",
#      and under "Page views" > Show advanced settings switch OFF "Page changes based on browser
#      history events". (The site sends its own cleaned page views; left on, every page change
#      counts twice. gtag.js has no setting that turns these off from the page.)
#   2. Redact data: turn on "Redact email" and, under "Redact query parameters", add
#      f_name, l_name, email, phone, dc_zip, dc_notes, dc_entry, dc_park, dc_clean
#      (the BookingKoala prefill parameters), as a second line of defence.
#   3. Google signals: leave off.
VITE_GA4_MEASUREMENT_ID=
