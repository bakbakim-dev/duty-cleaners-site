 {
 "@type": "Review",
 "author": {
 "@type": "Person",
 "name": "Flagg"
 },
 "datePublished": "2 months ago",
 "reviewBody": "This was our first experience of having a cleaning service in our home.  We were a bit anxious and spent probably too much time preparing the house for them.\nThe staff were prompt, organized, and came with all they needed to complete the tasks without our assistance or support.\nMy wife and I had a list of expectations that we shared with the staff but also to compare with the completed result.\nWe went with the standard clean and a deep clean for our first go.  The staff worked diligently and efficiently.  The end result exceeding our expectations.  Bathrooms, kitchen, floors, carpets, baseboards, vents, and every horizontal surface were left clean and tidy.\nEven now 3 days later I can still smell and see the cleanliness.\nHighly recommend Duty Cleaners and have already booked our next cleaning.",
 "reviewRating": {
 "@type": "Rating",
 "bestRating": "5",
 "ratingValue": "5.0",
 "worstRating": "1"
 }
 },
 {
